# このファイルをコピーして `.env.local` を作成し、値を埋める。
# `.env.local` は .gitignore 済み（コミットしないこと）。

# --- Supabase ---------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role キー（全権限）。サーバー専用。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- 合言葉 ----------------------------------------------------------------
# 「名前の管理」の変更操作で要求する管理用合言葉（サーバー専用）
ADMIN_PASSCODE=

# サイト全体を保護する共通合言葉（サーバー専用）。
# 署名付きセッション Cookie の署名鍵もこの値から導出する。
SITE_PASSCODE=
